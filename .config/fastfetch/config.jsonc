{
	"logo": {
		"type": "auto",	    // Logo type: auto, builtin, small, file, etc.

		"padding": {
			"top": 2,

			"left": 2,

			"right": 2
		},

		"color": {
			"1": "#399eb4",

			"2": "#b8b8b8"
		}
	},

	"display": {
		"separator": "", // Separator between keys and values

		"constants": [
			"──────────────────────────────────────────────", // {$1} - horizontal line for borders
			"\u001b[47D", // {$2} - move cursor left 47 columns
			"\u001b[47C", // {$3} - move cursor right 47 columns
			"\u001b[46C" // {$4} - move cursor right 46 columns
		],

		"brightColor": false

	},
	"modules": [
	{
		"type": "custom",

		"key": "{##399eb4}┌───────────────{$1}┐\u001b[41D"
	},

	{
		"type": "os",
		
		"key": "{##399eb4}│ {icon}  \u001b[s{sysname}\u001b[u\u001b[10C{$3}│{$2}"
	},

	{
		"type": "kernel",

		"key": "{##399eb4}│ {icon}  \u001b[sKernel\u001b[u\u001b[10C{$3}│{$2}"
	},

	{
		"type": "custom",

		"key": "{##399eb4}│───────────────{$1}│{#keys}\u001b[37D",

		"format": "{##399eb4} Hardware "
	},
	
	{
		"type": "cpu",

		"key": "{##399eb4}│ {icon}  CPU       {$3}│{#keys}{$2}",

		"showPeCoreCount": false,

		"format": "{name}"
	},

	{
		"type": "gpu",

		"key": "{##399eb4}│ {icon}  GPU       {$3}│{#keys}{$2}",

		"format": "{name}"
	},

	{
		"type": "memory",

		"key": "{##399eb4}│ {icon}  RAM       {$3}│{#keys}{$2}",
	
		"format": "{used} / {total}"
	},

	{
		"type": "swap",

		"key": "{##399eb4}│ {icon}  SWAP      {$3}│{#keys}{$2}",

		"format": "{used} / {total}"
	},

	{
		"type": "disk",

		"key": "{##399eb4}│ {icon}  Disk      {$3}│{#keys}{$2}",

		"format": "{size-used} / {size-total} > {filesystem}"
	},

	{
		"type": "battery",

		"key": "{##399eb4}│ {icon}  Battery   {$3}│{#keys}{$2}"
	},
	{
		"type": "custom",

		"key": "{##399eb4}│───────────────{$1}│{#keys}\u001b[37D",

		"format": "{##399eb4} Desktop "
	},

	{
		"type": "de",

		"key": "{##399eb4}│ {icon}  Desktop   {$3}│{#keys}{$2}"
	},

	{
		"type": "wm",

		"key": "{##399eb4}│ {icon}  WM        {$3}│{#keys}{$2}",

		"format": "{pretty-name} {version}< {protocol-name}"
	},

	{
		"type": "display",

		"key": "{##399eb4}│ {icon}  Display   {$3}│{#keys}{$2}",

		"format": "{width}x{height} / {refresh-rate}"
	},

	{
		"type": "gpu",

		"key": "{##399eb4}│ {icon}  Driver    {$3}│{#keys}{$2}",

		"format": "{driver}"
	},

	{
		"type": "custom",

		"key": "{##399eb4}│───────────────{$1}│{#keys}\u001b[37D",

		"format": "{##399eb4} Terminal "
	},

	{
		"type": "shell",

		"key": "{##399eb4}│ {icon}  Shell     {$3}│{#keys}{$2}"
	},

	{
		"type": "terminal",

		"key": "{##399eb4}│ {icon}  Terminal  {$3}│{#keys}{$2}"
	},

	{
		"type": "terminalfont",

		"key": "{##399eb4}│ {icon}  Term Font {$3}│{#keys}{$2}"
	},

	{
		"type": "packages",

		"key": "{##399eb4}│ {icon}  Packages  {$3}│{#keys}{$2}"
	},

	{
		"type": "custom",

		"key": "{##399eb4}│───────────────{$1}│{#keys}\u001b[36D",

		"format": "{##399eb4} Uptime "
	},

	{
		"type": "uptime",

		"key": "{##399eb4}│ {icon}  Uptime    {$3}│{#keys}{$2}"
	},

	{
		"type": "disk",

		"keyIcon": "",

		"key": "{##399eb4}│ {icon}  OS Age    {$3}│{#keys}{$2}",

		"folders": "/",                                   // Check root filesystem

		"format": "{create-time:10} [{days} days]"        // Show creation time and age in days
	},

	{
		"type": "custom",
		"key": "{##399eb4}└───────────────{$1}┘{#keys}",
		"format": ""
	}
	]
}
