[Event/Textcompletion: no match]
Action=Sound

[Event/Textcompletion: partial match]
Action=Sound

[Event/Textcompletion: rotation]
Action=Sound

[Event/applicationcrash]
Action=Popup|Sound
Sound=file:///usr/share/sounds/ocean/stereo/dialog-error.oga

[Event/exitkde]
Action=Sound

[Event/messageCritical]
Action=Popup|Sound|Taskbar

[Event/startkde]
Action=Sound
